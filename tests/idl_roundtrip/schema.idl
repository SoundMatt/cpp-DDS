// schema.idl — round-trip test fixture for the cpp-DDS ddstool IDL compiler.
// Mirrors go-DDS's tools/idl/roundtrip/schema.idl exactly (same field/type
// shapes) so the two reference implementations can be compared field-for-
// field. Exercises: primitives, string, boolean, array, sequence, enum,
// nested struct, typedef, and @key annotation.

typedef unsigned long TopicID;

enum Priority { LOW, MEDIUM, HIGH, CRITICAL };

struct Header {
    @key string   topic_id;
    long long     timestamp_ns;
    Priority      priority;
};

struct Telemetry {
    Header        header;
    double        values[4];
    float         temperature;
    boolean       valid;
    sequence<double> extras;
};
